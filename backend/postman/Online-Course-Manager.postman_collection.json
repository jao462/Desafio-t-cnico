{
  "info": {"name": "Online Course Manager API", "_postman_id": "a44a1ef2-0000-4000-8000-000000000001", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://localhost:3001"}, {"key": "userId", "value": "replace-with-user-uuid"}, {"key": "courseId", "value": "replace-with-course-uuid"}, {"key": "moduleId", "value": "replace-with-module-uuid"}, {"key": "contentId", "value": "replace-with-content-uuid"}],
  "item": [
    {"name": "Health", "request": {"method": "GET", "url": "{{baseUrl}}/api/health"}},
    {"name": "Users", "item": [
      {"name": "List users", "request": {"method": "GET", "url": "{{baseUrl}}/api/users"}},
      {"name": "Create user", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"new.user@example.com\",\n  \"status\": \"active\"\n}"}, "url": "{{baseUrl}}/api/users"}},
      {"name": "Get user", "request": {"method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}"}},
      {"name": "Update user", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Updated User\"\n}"}, "url": "{{baseUrl}}/api/users/{{userId}}"}},
      {"name": "Delete user", "request": {"method": "DELETE", "url": "{{baseUrl}}/api/users/{{userId}}"}}
    ]},
    {"name": "Courses", "item": [{"name": "List courses", "request": {"method": "GET", "url": "{{baseUrl}}/api/courses"}}, {"name": "Create course", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"code\": \"NEW-001\",\n  \"title\": \"New Course\",\n  \"description\": \"Course description\",\n  \"user_id\": \"{{userId}}\"\n}"}, "url": "{{baseUrl}}/api/courses"}}]},
    {"name": "Modules", "item": [{"name": "List modules", "request": {"method": "GET", "url": "{{baseUrl}}/api/modules"}}, {"name": "Create module", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"course_id\": \"{{courseId}}\",\n  \"title\": \"New Module\",\n  \"description\": \"Module description\",\n  \"user_id\": \"{{userId}}\"\n}"}, "url": "{{baseUrl}}/api/modules"}}]},
    {"name": "Contents", "item": [{"name": "List contents", "request": {"method": "GET", "url": "{{baseUrl}}/api/contents"}}, {"name": "Create content", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"module_id\": \"{{moduleId}}\",\n  \"title\": \"New Lesson\",\n  \"content\": \"Lesson text\"\n}"}, "url": "{{baseUrl}}/api/contents"}}]},
    {"name": "Reports", "item": [{"name": "Users by courses", "request": {"method": "GET", "url": "{{baseUrl}}/api/reports/users-courses"}}, {"name": "Courses by contents", "request": {"method": "GET", "url": "{{baseUrl}}/api/reports/courses-content-count"}}, {"name": "Course summary", "request": {"method": "GET", "url": "{{baseUrl}}/api/reports/courses-summary"}}, {"name": "Contents with course", "request": {"method": "GET", "url": "{{baseUrl}}/api/reports/contents-with-course"}}, {"name": "Users who watched content", "request": {"method": "GET", "url": "{{baseUrl}}/api/reports/content-2-viewers?contentId={{contentId}}"}}]},
    {"name": "Progress", "item": [{"name": "List watched lessons", "request": {"method": "GET", "url": "{{baseUrl}}/api/progress"}}, {"name": "Mark lesson as watched", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"content_id\": \"{{contentId}}\"\n}"}, "url": "{{baseUrl}}/api/progress"}}]}
  ]
}
